{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<form method="post" class="card" style="max-width:24rem;margin:2rem auto">
    <h1>Connexion</h1>
    {% if error %}<p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
    <label for="username">Email</label>
    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
    <label for="password" style="margin-top:.75rem">Mot de passe</label>
    <input type="password" id="password" name="_password" autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <div class="actions"><button type="submit">Se connecter</button></div>
</form>
{% endblock %}
