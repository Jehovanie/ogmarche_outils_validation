<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if app.user %}<meta name="csrf-token" content="{{ csrf_token('marche') }}">{% endif %}
        <title>{% block title %}Validation des marchés{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <header class="topbar">
            <a href="{{ path('app_dep_choice') }}" class="brand">Validation des marchés</a>
            {% if app.user %}
                <span>{{ app.user.name ?: app.user.userIdentifier }} · <a href="{{ path('app_logout') }}">Déconnexion</a></span>
            {% endif %}
        </header>
        <main>{% block body %}{% endblock %}</main>
    </body>
</html>
