<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if app.user %}<meta name="csrf-token" content="{{ csrf_token('marche') }}">{% endif %}
        <title>{% block title %}Validation des marchés{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% if app.user %}
            <nav class="nav">
                <a href="{{ path('app_dep_choice') }}" class="nav-titre">Validation des marchés</a>
                <a href="{{ path('app_dep_choice') }}">Mes départements</a>
                {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_home') }}">Administration</a>{% endif %}
                <span class="nav-fin">
                    <span class="muted">{{ app.user.libelle }}</span>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                </span>
            </nav>
        {% endif %}
        <main>
            {% for type, messages in app.flashes %}
                {% for message in messages %}<p class="flash {{ type }}" role="status">{{ message }}</p>{% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
