{% extends 'base.html.twig' %}
{% block title %}Fiche {{ marche.id }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">{% endblock %}
{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js" defer></script>
<script src="{{ asset('js/validation.js') }}" defer></script>
{% endblock %}
{% block body %}
<section id="fiche"
         data-csrf="{{ csrf_token('marche') }}"
         data-id="{{ marche.id }}"
         data-next="{{ path('app_fiche', {dep: dep, insee: insee}) }}"
         data-api-garde="{{ path('api_marche_garde', {id: marche.id}) }}"
         data-api-traite="{{ path('api_marche_traite', {id: marche.id}) }}"
         data-api-lier="{{ path('api_marche_lier', {id: marche.id}) }}"
         data-api-candidats="{{ path('api_marche_candidats', {id: marche.id}) }}">
    <div class="fiche-head">
        <a href="{{ path('app_communes', {dep: dep}) }}" class="btn-link secondary">← Communes du {{ dep }}</a>
        {# decision garder / ne pas garder, portee par les fiches "existence a valider" du groupe #}
        {% if decision.possible %}
            <div class="decision-garde" role="group" aria-label="Décision sur la fiche">
                <button type="button" class="secondary btn-garde" data-valeur="1" aria-pressed="{{ decision.garde is same as(true) ? 'true' : 'false' }}">{{ decision.garde is same as(true) ? 'Gardée ✓' : 'Garder' }}</button>
                <button type="button" class="secondary btn-garde" data-valeur="0" aria-pressed="{{ decision.garde is same as(false) ? 'true' : 'false' }}">{{ decision.garde is same as(false) ? 'Pas gardée ✓' : 'Ne pas garder' }}</button>
            </div>
        {% endif %}
        <button type="button" id="btn-traite">{{ groupe|length > 1 ? 'Traiter le groupe et passer à la suivante' : 'Traiter et passer à la suivante' }}</button>
    </div>
    <div id="message-page" role="status"></div>

    <div class="fiche-grid">
        {% for m in groupe %}
            {% include 'validation/_fiche_card.html.twig' with {m: m, groupe: groupe} only %}
        {% endfor %}
    </div>

    <article class="card" id="doublons">
        <h2>Doublons</h2>
        <p class="muted">Cherchez les fiches de vos communes qui partagent le code postal, la commune ou la dénomination de cette fiche, puis liez celles qui désignent le même marché : elles seront validées ensemble.</p>
        <div class="actions">
            {% set nomRecherche = marche.denominationNormalise ?: marche.denomination %}
            <button type="button" class="secondary" id="btn-search-denomination" {% if not nomRecherche %}disabled{% endif %}>
                Recherche par dénomination ({{ nomRecherche ?: 'aucune' }})
            </button>
            <button type="button" class="secondary" id="btn-search-cp" {% if not marche.codePostal %}disabled{% endif %}>
                Recherche par code postal ({{ marche.codePostal ?: 'aucun' }})
            </button>
            <button type="button" class="secondary" id="btn-search-commune" {% if not marche.commune %}disabled{% endif %}>
                Recherche par commune ({{ marche.commune ?: 'aucune' }})
            </button>
            <button type="button" class="secondary" id="btn-search-reset">Réinitialiser</button>
        </div>
        <div id="doublons-resultats" class="doublons-resultats" hidden>
            <table id="doublons-table" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th><th>Dénomination normalisée</th><th>N° voie</th><th>Type voie</th><th>Nom voie</th>
                        <th>Code postal</th><th>Commune</th><th>Groupe</th><th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </article>
</section>
{% endblock %}
