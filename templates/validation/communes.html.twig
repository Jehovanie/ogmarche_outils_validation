{% extends 'base.html.twig' %}
{% block title %}Communes {{ dep }}{% endblock %}
{% block body %}
<p><a href="{{ path('app_dep_choice') }}">← Départements</a></p>
<h1>Département {{ dep }}</h1>
<table class="card">
    <thead><tr><th>INSEE</th><th>Commune</th><th>Fiches</th><th>À traiter</th></tr></thead>
    <tbody>
    {% for item in items %}
        <tr>
            <td>{{ item.codeInsee }}</td>
            <td>{% if item.aTraiter > 0 %}<a href="{{ path('app_fiche', {dep: dep, insee: item.codeInsee}) }}">{{ item.commune }}</a>{% else %}{{ item.commune }} <span class="muted">(terminée)</span>{% endif %}</td>
            <td>{{ item.total }}</td>
            <td>{{ item.aTraiter }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
